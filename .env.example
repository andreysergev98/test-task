API_KEY=local-development-key-change-me
API_DOCS_ENABLED=true
POSTGRES_DB=payments
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments-local-password
RABBITMQ_USER=payments
RABBITMQ_PASSWORD=payments-local-password
DATABASE_URL=postgresql+asyncpg://payments:payments-local-password@localhost:5432/payments
RABBITMQ_URL=amqp://payments:payments-local-password@localhost:5672/
LOG_LEVEL=INFO
GATEWAY_MIN_DELAY=2
GATEWAY_MAX_DELAY=5
GATEWAY_SUCCESS_RATE=0.9
MAX_ATTEMPTS=3
RETRY_BASE_DELAY=2
WEBHOOK_TIMEOUT=10
WEBHOOK_ALLOWED_HOSTS=webhook
OUTBOX_POLL_INTERVAL=0.5
OUTBOX_BATCH_SIZE=100
BROKER_PUBLISH_TIMEOUT=5
